    },
    {
      "id": 2,
      "title": "Latest Numeric Snapshots",
      "type": "table",
      "datasource": {
        "type": "mssql",
        "uid": "POSFMSQL001"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT TOP 200 ts, source, station_id, sensor_type, metric_name, value_numeric, reason FROM env_sensor_snapshot WHERE value_numeric IS NOT NULL ORDER BY ts DESC"
        }
      ]
    }
  ]
}
