# Local SQL Server (Compose service mssql → osf-edge-mssql)
MSSQL_SA_PASSWORD=Osf_Edge_Dev1!
MSSQL_EXTERNAL_PORT=1433
MSSQL_DB=osf_edge
MSSQL_USER=osf_edge
MSSQL_PASSWORD=OsfEdge_App9#
MSSQL_GRAFANA_URL=host.docker.internal:1433

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_EXTERNAL_PORT=3000
QUERY_API_EXTERNAL_PORT=3081

# Test profile: REPLAY mode
# Persistence service subscribes to local host broker via docker host gateway.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=osf-persistence-edge-replay

PERSISTENCE_MODE=replay
# Session-gate: Replay Station publishes osf/persistence/replay/session begin/commit.
# Already ingested session filenames are skipped until reset-replay-db.sh.
RAW_RETENTION_DAYS=14
SENSOR_INTERVAL_SECONDS=5
SENSOR_IDLE_INTERVAL_SECONDS=60
ENABLE_RAW_MESSAGES=true
ENABLE_CAMERA_TOPIC=false
LOG_LEVEL=info
