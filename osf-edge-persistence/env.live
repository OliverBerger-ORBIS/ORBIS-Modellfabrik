# Local SQL Server (Compose service mssql → osf-edge-mssql)
MSSQL_SA_PASSWORD=Osf_Edge_Dev1!
MSSQL_EXTERNAL_PORT=1433
MSSQL_DB=osf_edge
MSSQL_USER=osf_edge
# App user (not sa). Create: bash scripts/mssql-create-app-user.sh
MSSQL_PASSWORD=OsfEdge_App9#
MSSQL_GRAFANA_URL=host.docker.internal:1433

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_EXTERNAL_PORT=3000
QUERY_API_EXTERNAL_PORT=3081

# Default profile: LIVE mode
# Persistence service subscribes to APS broker (RPi).
MQTT_HOST=192.168.0.100
MQTT_PORT=1883
MQTT_USERNAME=default
MQTT_PASSWORD=default
MQTT_CLIENT_ID=osf-persistence-edge-live

PERSISTENCE_MODE=live
# Replay must not target .201 — use env.replay + local DB only (session-gate).
RAW_RETENTION_DAYS=14
SENSOR_INTERVAL_SECONDS=5
SENSOR_IDLE_INTERVAL_SECONDS=60
ENABLE_RAW_MESSAGES=true
ENABLE_CAMERA_TOPIC=false
LOG_LEVEL=info
